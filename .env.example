# ─────────────────────────────────────────────────────────────
# تنظیمات اتصال پنل هوشمند به مدل هوش مصنوعی واقعی
# بدون این تنظیمات، ابزارها به حالت نمونه (دمو) برمی‌گردند.
# ─────────────────────────────────────────────────────────────

# کلید API — هر سرویس سازگار با OpenAI (OpenAI ،Groq ،DeepSeek ،Ollama و...)
AI_API_KEY=

# آدرس پایه سرور مدل (پیش‌فرض: OpenAI)
AI_BASE_URL=https://api.openai.com/v1

# نام مدل
AI_MODEL=gpt-4o-mini